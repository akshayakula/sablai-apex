<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>57.0</apiVersion>
    <description>Sends lead phone number to external server for outbound call after validation.</description>
    <interviewLabel>Send Lead to Server {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Send Lead to Server</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <start>
        <locationX>50</locationX>
        <locationY>50</locationY>
        <connector>
            <targetReference>Send_To_Server</targetReference>
        </connector>
    </start>
    <actionCalls>
        <name>Send_To_Server</name>
        <label>Send To Server</label>
        <locationX>446</locationX>
        <locationY>50</locationY>
        <actionName>LeadOutboundCallHandler</actionName>
        <actionType>apex</actionType>
        <connector>
            <targetReference>Success_Path</targetReference>
        </connector>
        <inputParameters>
            <name>inputs</name>
            <value>
                <elementReference>LeadName</elementReference>
            </value>
        </inputParameters>
    </actionCalls>
    <assignments>
        <name>Success_Path</name>
        <label>Success Path</label>
        <locationX>446</locationX>
        <locationY>156</locationY>
        <assignmentItems>
            <assignToReference>SuccessMessage</assignToReference>
            <operator>Assign</operator>
            <value>
